# Custom Configuration (Specified in Station Profile)
# startcustomconfig(custom_config_bottom)
#
# What is This Script?
# This script allows you to broadcast your AzuraCast radio signal to an Icecast video stream, using a
# static video file that loops in the background and dynamically writing the currently playing track
# on top of that video file.
#
# This script is based on the YouTube streaming script but modified to output to an Icecast mount point.
#
# To use this script, you must be running at least AzuraCast 0.24.0 or a later Rolling Release version.
#
# Before Using This Script:
# - Upload a video file to a folder under your station's media library
# - Choose a font to display Now Playing data and upload a TTF version of that font to the same folder
#
# How to Use This Script
# - Copy the section below.
# - Visit your station's "Edit Liquidsoap Configuration" section (under "Broadcasting" in newer versions)
# - Paste the code into the bottom-most configuration section
# - Customize as necessary with your station's media directory and font specifications
# - Click "Save Changes" and then "Restart Broadcasting"
# - Enjoy!
#
# VIDEO STREAM

# Edit This: Station Base Directory
station_base_dir = "/var/azuracast/stations/station_name"

# Edit This: Icecast Mount Point
mount_point = "/video.ts"

# Edit This: Icecast Password
icecast_password = "ENTER_ICECAST_PASSWORD"

# Path to the video file that will loop behind the Now Playing text (you have to provide this)
video_file = station_base_dir ^ "/media/videostream/video.mp4"

# Path to a font (TTF) file that will be used to draw the Now Playing text (you have to provide this)
font_file = station_base_dir ^ "/media/videostream/font.ttf"

# A static file auto-generated by AzuraCast in the "config" dir.
nowplaying_file = station_base_dir ^ "/config/nowplaying.txt"

# Align text settings
font_size = "50"
font_x = "70"
font_y = "990"
font_color = "white"

# Method to overlay now playing text
def add_nowplaying_text(s) =
  def mkfilter(graph)
    let {video = video_track} = source.tracks(s)
    video_track = ffmpeg.filter.video.input(graph, video_track)
    video_track = ffmpeg.filter.drawtext(
      graph,
      video_track,
      fontfile=font_file,
      fontsize=font_size,
      x=font_x,
      y=font_y,
      fontcolor=font_color,
      textfile=nowplaying_file,
      reload=5,
      bordercolor="black",
      borderw=2,
      shadowcolor="black",
      shadowx=2,
      shadowy=2
    )
    video_track = ffmpeg.filter.video.output(graph, video_track)
    source({ video = video_track })
  end
  ffmpeg.filter.create(mkfilter)
end

# Make the radio source infallible by adding a fallback
radio_infallible = fallback(track_sensitive=false, [radio, blank(duration=1.0)])

# Then use this infallible source in your mux
# Use a normal playlist so the background video repeats continuously.
videostream = playlist(mode="normal", [video_file])
videostream = add_nowplaying_text(videostream)
videostream = source.mux.video(video=videostream, radio_infallible)

# Output to Icecast
enc = %ffmpeg(
  format="flv",
  %video.raw(codec="libx264",
    pixel_format="yuv420p",
    b="2500k",
    preset="veryfast",
    r=30,
    g=60,
    width=1920,
    height=1080
  ),
  %audio(
    codec="aac",
    samplerate=44100,
    channels=2,
    b="320k",
    profile="aac_low"
  )
)

output.icecast(
  enc,
  host="127.0.0.1",
  port=your stations port number,
  password=icecast_password,
  mount=mount_point,
  name="Your Station Name (Video)",
  description="Your station slogan or description",
  genre="Your Station's genre",
  public=true,
  encoding="UTF-8",
  send_icy_metadata=false,
  fallible=true,
  videostream
)
# endcustomconfig(custom_config_bottom)
